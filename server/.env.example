# Server-only runtime environment. Copy to server/.env and supply real values.
# Both dev and production entrypoints load server/.env independent of cwd.
# Host environment overrides this file. Never commit secrets or prefix them VITE_.

# Required to boot (Supabase SDK; no offline database fallback).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Required to boot: independent strong signing secret, no Supabase-key fallback.
ADMIN_JWT_SECRET=

# Optional; HTTP admin provisioning returns 503 when empty.
# This is NOT required by the direct Supabase create-admin script.
ADMIN_REGISTRATION_SECRET=

# Required for REAL payments, optional for boot. Empty enables existing demo mode.
PAYSTACK_SECRET_KEY=

# Required for separate-origin frontend hosting; comma-separated exact origins.
# Current middleware also allows localhost origins, including in production.
CORS_ORIGIN=

# Default 3001; Vite dev proxy expects 3001.
PORT=3001
# Production hosts/Docker set NODE_ENV=production; leave unset for npm run dev.

