# Client build inputs — copy to client/.env only if needed.
# All VITE_* values are PUBLIC in the bundle. Never put server secrets here.
# Empty: Vite /api proxy in dev; Express same-origin serving in production.
# Separate frontend hosting: HTTPS Express origin, no trailing slash or /api.
VITE_API_URL=

# Public Supabase session integration used by AuthContext (not admin JWT login).
# Optional for loading the UI; configure both for real Supabase session behavior.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Public Paystack inline key. Real payments also require server PAYSTACK_SECRET_KEY.
# Missing keys permit existing demo behavior; not production payment verification.
VITE_PAYSTACK_PUBLIC_KEY=

