# Copy this file to .env (or set environment variables in your hosting platform)
# Variables prefixed with VITE_ are exposed to the browser (do NOT put secrets there)

# Public (frontend)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_AUTH_PROXY=
VITE_PAYSTACK_PUBLIC_KEY=

# Server / secrets (keep private)
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_JWT_SECRET=
PAYSTACK_SECRET_KEY=

# Optional (used by fullstack restore tooling)
FULLSTACK_PROJECT_REF=
FULLSTACK_RESTORE_API_URL=
# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin JWT (used for admin session signing)
ADMIN_JWT_SECRET=your-random-secret

# Google OAuth (optional)
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_AUTH_PROXY=

# Paystack Card Payments
VITE_PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
