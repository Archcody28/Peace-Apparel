# Peace-Apparel — environment setup
#
# This is a SINGLE reference file documenting every environment variable used by
# the project. Copy the relevant sections into the real env files and fill them:
#
#   - Frontend:  copy client/.env.example -> client/.env  (consumed by Vite, prefixed VITE_)
#   - Backend:   copy server/.env.example -> server/.env  (consumed by the Express server)
#   - Scripts:   the admin bootstrap scripts (scripts/*.js) read variables from a
#                root-level .env if present; otherwise use process.env.
#
# Public variables (VITE_*) are embedded in the client bundle at build time.
# NEVER put secrets in VITE_-prefixed variables.

# ---- Frontend (client/.env) ----
# Supabase frontend credentials (public anon key)
VITE_SUPABASE_URL=https://wbsvuvnsluscfprjjwue.supabase.co
VITE_SUPABASE_ANON_KEY=
# Embedded at build time. Empty uses the Vite /api proxy in development.
# Split production: set the HTTPS Express origin (no trailing slash or /api).
# Same-origin Express production serving also supports an empty value.
VITE_API_URL=
# Paystack public key (enables real Paystack inline; if empty, checkout uses demo mode)
VITE_PAYSTACK_PUBLIC_KEY=

# ---- Backend (server/.env) — keep private ----
# Supabase service-role credentials (used server-side only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Admin session JWT signing secret (server-side only)
ADMIN_JWT_SECRET=
# Admin registration gate (required by POST /api/register-admin)
ADMIN_REGISTRATION_SECRET=
# Paystack secret for real card verification (server-side only)
PAYSTACK_SECRET_KEY=
# Separate-origin frontend allowlist (exact origins, comma-separated).
CORS_ORIGIN=
# Development proxy expects this port.
PORT=3001
# Hosts set NODE_ENV=production; npm run dev requires a non-production environment.
# Root npm start also loads server/.env; root .env is for scripts, not the server.

# ---- Admin bootstrap scripts (root .env, optional) ----
# scripts/create-admin.js and scripts/generate-admin-token.js can read these from
# a root .env file. They reuse the same names as the server.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# ADMIN_JWT_SECRET=
